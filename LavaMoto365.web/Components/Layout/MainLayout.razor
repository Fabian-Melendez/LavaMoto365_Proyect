@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @* El cambio de tema lo gestiona wwwroot/js/theme.js (sin JS interop), por lo que
               funciona tambien en las paginas con renderizado estatico (Login, Register, etc.). *@
            <button type="button"
                    class="theme-toggle"
                    data-theme-toggle
                    aria-pressed="false"
                    title="Cambiar entre modo claro y modo oscuro">
                <span class="theme-toggle__label--light">🌙 Modo oscuro</span>
                <span class="theme-toggle__label--dark">☀️ Modo claro</span>
            </button>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
