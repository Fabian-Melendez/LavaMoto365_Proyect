@page "/proveedores"
@using System.ComponentModel.DataAnnotations
@using LavaMoto365.Domain.Entities
@using LavaMoto365.Domain.Exceptions
@using LavaMoto365.Infrastructure.Services
@inject ProveedorService Servicio
@* Cuando el login esté listo: @attribute [Authorize]  (con @using Microsoft.AspNetCore.Authorization) *@

<PageTitle>Proveedores</PageTitle>

<h1>Proveedores</h1>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success")">@mensaje</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Registrar Nuevo Proveedor</h5>
    </div>
    <div class="card-body">
        <EditForm Model="form" OnValidSubmit="GuardarAsync">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">NIT</label>
                    <InputText class="form-control" @bind-Value="form.Nit" placeholder="Ej: 12345" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Nombre</label>
                    <InputText class="form-control" @bind-Value="form.Nombre" placeholder="Ej: Jairo" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Correo</label>
                    <InputText class="form-control" @bind-Value="form.Correo" placeholder="proveedor@correo.com" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Cupo de Crédito ($)</label>
                    <InputNumber class="form-control" @bind-Value="form.Presupuesto" placeholder="0" />
                </div>
            </div>

            <div class="mt-3 text-end">
                <button class="btn btn-primary px-4" type="submit">Registrar Proveedor</button>
            </div>

            <ValidationSummary class="text-danger mt-2" />
        </EditForm>
    </div>
</div>

@if (proveedores is null)
{
    <p>Cargando...</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>NIT</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Cupo Disponible</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in proveedores)
            {
                <tr>
                    <td>@p.Nit</td>
                    <td>@p.Nombre</td>
                    <td>@p.Correo</td>
                    <td>@p.Presupuesto.ToString("C0")</td>
                    <td>
                        @if (p.EstaActivo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (p.EstaActivo)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DesactivarAsync(p.Id)">Desactivar</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => ReactivarAsync(p.Id)">Reactivar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Proveedor>? proveedores;
    private FormularioProveedor form = new();
    private string? mensaje;
    private bool esError;

    protected override async Task OnInitializedAsync() => proveedores = await Servicio.ListarAsync();

    private async Task GuardarAsync()
    {
        try
        {
            await Servicio.CrearAsync(form.Nit, form.Nombre, form.Correo, form.Presupuesto);
            Notificar("Proveedor registrado", false);
            form = new();
            proveedores = await Servicio.ListarAsync();
        }
        catch (ReglaDeNegocioException ex) { Notificar(ex.Message, true); }
    }

    private async Task DesactivarAsync(int id)
    {
        try
        {
            await Servicio.DesactivarAsync(id);
            Notificar("Proveedor desactivado correctamente", false);
            proveedores = await Servicio.ListarAsync();
        }
        catch (ReglaDeNegocioException ex) { Notificar(ex.Message, true); }
    }

    private async Task ReactivarAsync(int id)
    {
        try
        {
            await Servicio.ReactivarAsync(id);
            Notificar("Proveedor reactivado", false);
            proveedores = await Servicio.ListarAsync();
        }
        catch (ReglaDeNegocioException ex) { Notificar(ex.Message, true); }
    }

    private void Notificar(string texto, bool error) { mensaje = texto; esError = error; }

    private class FormularioProveedor
    {
        [Required(ErrorMessage = "El NIT es obligatorio")] public string Nit { get; set; } = "";
        [Required(ErrorMessage = "El nombre es obligatorio")] public string Nombre { get; set; } = "";
        [Required(ErrorMessage = "El correo es obligatorio"), EmailAddress(ErrorMessage = "Formato de correo inválido")]
        public string Correo { get; set; } = "";
        [Range(0, double.MaxValue, ErrorMessage = "El cupo de crédito no puede ser negativo")]
        public decimal Presupuesto { get; set; }
    }
}